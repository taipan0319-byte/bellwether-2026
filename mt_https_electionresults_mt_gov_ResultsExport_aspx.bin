    <script type="text/javascript">
        function Show_Div(Div_id) {
            if (false == $(Div_id).is(':visible')) {
                $(Div_id).show(650);
            }
            else {
                $(Div_id).hide(650);
            }
            return false;
        }
    </script>
    <script>
        (function ($) {
            $(document).ready(function () {
                $('#menuToggle').click(function (e) {
                    var $parent = $(this).parent('nav');
                    $parent.toggleClass('open');
                    var navState = $parent.hasClass('open') ? 'hide' : 'show';
                    $(this).attr('title', navState + ' navigation');
                    setTimeout(function () {
                        console.log('timeout set');
                        $('#menuToggle > span').toggleClass('navClosed').toggleClass('navOpen');
                    }, 200);
                    e.preventDefault();
                });
            });
        }(jQuery));
        //@ sourceURL=pen.js
    </script>
    <script>
        Chart.defaults.responsive = false;
        //Chart.defaults.Doughnut.segmentShowStroke = false;
        var chOptions = {
            plugins: {
                legend: {
                    display: false
                }
            },
            layout: {
                padding: {
                    top: 0,
                    right: 0,
                    left: 0,
                    bottom: 0
                }
            }
        };

        var turnout = document.getElementById("voter-turnout");
        const turnoutChart = turnout.getContext("2d");

        var voterTurnout = turnout.attributes["voterturnout"].value;
        var totalVoters = turnout.attributes["votertotal"].value;
        turnoutChart.canvas.width = 125;
        turnoutChart.canvas.height = 150;

        var turnoutdata = {
            labels: ['Votes Cast', 'Votes Not Cast'],
            datasets: [{
                data: [voterTurnout, totalVoters],
                backgroundColor: ['#FAA437', '#F2F2F2'],
                cutout: '80%',
                borderWidth: 0
            }]
        };

        var turnoutDough = new Chart(turnoutChart, {
            type: 'doughnut',
            data: turnoutdata,
            options: chOptions
        });

        var mobileTurnout = document.getElementById("voter-turnout-mobile");
        const mobileTurnoutChart = mobileTurnout.getContext("2d");
        mobileTurnoutChart.canvas.width = 55;
        mobileTurnoutChart.canvas.height = 75;

        var mobileTurnoutDough = new Chart(mobileTurnoutChart, {
            type: 'doughnut',
            data: turnoutdata,
            options: chOptions
        });

        var prec = document.getElementById("precinct-reported"); //$('#precinct-reported');
        var precinctsReported = prec.attributes["precinctsreported"].value;
        var precinctsPartial = prec.attributes["precinctspartial"].value;
        var precinctsTotal = prec.attributes["precinctsnotreported"].value;
        const precChart = prec.getContext("2d");
        precChart.canvas.width = 125;
        precChart.canvas.height = 150;

        var precinctData = {
            labels: ["Precincts Reported", "Precincts Partially Reported", "Precincts Not Reported"],
            datasets: [{
                data: [precinctsReported, precinctsPartial, precinctsTotal],
                backgroundColor: ["#FAA437", "#FFFF00", "#F2F2F2"],
                cutout: '80%',
                borderWidth: 0
            }]
        };           

        var precDough = new Chart(precChart, {
            type: 'doughnut',
            data: precinctData,
            options: chOptions
        });

        var mobilePrec = document.getElementById("precinct-reported-mobile");
        const mobilePrecChart = mobilePrec.getContext("2d");
        mobilePrecChart.canvas.width = 55;
        mobilePrecChart.canvas.height = 75;

        var mobilePrecDough = new Chart(mobilePrecChart, {
            type: 'doughnut',
            data: precinctData,
            options: chOptions
        });
    </script>
</body>
</html>
