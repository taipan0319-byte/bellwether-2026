<div class="heading-flex">
    <div class="title-area">
        <div class="row">
            <h1>Minnesota Legislative Districts</h1>
            <input type="hidden" id="selectedScenario" value="StateRepresentative" />
            <input id="noDistrict" name="noDistrict" type="hidden" value="District Not In Election" />
            <input id="districtList" name="districtList" type="hidden" value="1A,1B,2A,2B,3A,3B,4A,4B,5A,5B,6A,6B,7A,7B,8A,8B,9A,9B,10A,10B,11A,11B,12A,12B,13A,13B,14A,14B,15A,15B,16A,16B,17A,17B,18A,18B,19A,19B,20A,20B,21A,21B,22A,22B,23A,23B,24A,24B,25A,25B,26A,26B,27A,27B,28A,28B,29A,29B,30A,30B,31A,31B,32A,32B,33A,33B,34A,34B,35A,35B,36A,36B,37A,37B,38A,38B,39A,39B,40A,40B,41A,41B,42A,42B,43A,43B,44A,44B,45A,45B,46A,46B,47A,47B,48A,48B,49A,49B,50A,50B,51A,51B,52A,52B,53A,53B,54A,54B,55A,55B,56A,56B,57A,57B,58A,58B,59A,59B,60A,60B,61A,61B,62A,62B,63A,63B,64A,64B,65A,65B,66A,66B,67A,67B" />
