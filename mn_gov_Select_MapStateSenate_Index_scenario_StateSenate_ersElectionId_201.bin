    <script>
        "use strict";

        window.onload = function () {
            //initializeMap(includeBaseTile, initialZoomLevel, minZoom, maxZoom);
            initializeMap(true, 7, 6, 10);

            //Draw MN county boundaries
            //reportingLevel = "cnty"; //county
            drawGeoJsonDataMap(counties, null, noFeatureObj);

            //Use district boundaries based on election date
            const currentRedistrictStartDate = new Date('2022-06-01T00:00:00');
            const electionDate = new Date(document.getElementById("electionDateStr").value);

            //Draw MN Senate boundaries
            //reportingLevel = "ss"; MN State Senate districts
            if (electionDate >= currentRedistrictStartDate) {
                //console.log("draw map with current districts, 20220601-20320531");
                drawGeoJsonDataMap(senate20220601_20320531, "ss", onEachGeoJSONFeature);
            }
            else {
                //console.log("draw map with old districts, 20120601-20220531");
                drawGeoJsonDataMap(senate20120601_20220531, "ss", onEachGeoJSONFeature);
            }
        }

        // close all tool tips and popups- window.onpageshow event runs from browser back button; document.ready and window.onload events do not
        window.onpageshow = function () {
            closeAllPopups();
        };
    </script>

